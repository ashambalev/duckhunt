# Python bytecode
__pycache__/
*.py[cod]

# pytest's scratch
.pytest_cache/

# Virtual environment
.venv/

# The old local high-score table. Nothing writes it any more, and the rounds
# that were in this repo's copy are on the board now; an existing one elsewhere
# is still ignored here, because `leaderboard.seed --from-scores` reads it.
scores.json

# The sight correction: measured on one gun, one screen, one way of holding it
calibration.json

# macOS
.DS_Store

# Test-run logs from tools/ir_view.py
logs/

# The scoreboard's database, its queue of unsent rounds, and the name file that
# the game stopped writing in Sept 2026 (an existing one is ignored, not tracked)
leaderboard.db
leaderboard.db-wal
leaderboard.db-shm
leaderboard.log
pending_runs.jsonl
player.json

# Playwright MCP scratch (screenshots, page snapshots), and screenshots of the
# board taken by hand next to them
.playwright-mcp/
board.png

# ./setup: what was picked for tonight (screens, sound, gun), and the board
# browser's own profile
launch.json
.board-browser/

# The board admin's undo journal and the copies it takes before every change
leaderboard-admin.jsonl
leaderboard-backups/

# The prize-giving slides: written by `python3 -m leaderboard.winners`, with names in
winners.html
