# Python bytecode
__pycache__/
*.py[cod]

# pytest's scratch
.pytest_cache/

# Virtual environment
.venv/

# The old local high-score table. Nothing writes it any more; an existing one is
# still ignored here because it is per-machine, and `leaderboard.seed
# --from-scores` can still put those evenings on the board.
scores.json

# The sight correction: measured on one gun, one screen, one way of holding it
calibration.json

# macOS
.DS_Store

# Test-run logs from tools/ir_view.py
logs/

# The scoreboard's database, its queue of unsent rounds, and the name file that
# the game no longer writes (an existing one is ignored rather than tracked)
leaderboard.db
leaderboard.db-wal
leaderboard.db-shm
leaderboard.log
pending_runs.jsonl
player.json

# Playwright MCP scratch (screenshots, page snapshots)
.playwright-mcp/
